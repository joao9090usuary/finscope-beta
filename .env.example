# Banco e limite da beta
POSTGRES_PASSWORD=substitua_por_uma_senha_aleatoria_com_32_caracteres
# Credencial diferente, usada pelo site sem privilégios de proprietário/superusuário.
POSTGRES_APP_PASSWORD=substitua_por_outra_senha_aleatoria_com_32_caracteres
# Em hospedagem gerenciada, use a URL privada fornecida pelo PostgreSQL no serviço da aplicação.
BETA_MAX_USERS=10
# Código compartilhado privadamente com os participantes; use um valor aleatório longo.
BETA_INVITE_CODE=substitua_por_um_codigo_aleatorio_longo
# Opcional: restrinja também os e-mails autorizados, separados por vírgula.
BETA_ALLOWED_EMAILS=
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Dados de mercado da B3 (token criado em https://brapi.dev/dashboard)
BRAPI_BASE_URL=https://brapi.dev/api
BRAPI_TOKEN=

# A Central de Ajuda funciona localmente; não são necessárias credenciais de IA.

# Endereço público final da aplicação
# Valores seguros para desenvolvimento local. Na hospedagem, troque para production e HTTPS.
APP_ENV=development
APP_BASE_URL=http://localhost:8501
# Em um servidor, mantenha 127.0.0.1 e coloque um proxy HTTPS na frente.
APP_BIND_ADDRESS=127.0.0.1
# Mantém a assinatura de cookies estável; gere um valor aleatório com pelo menos 32 bytes.
STREAMLIT_SERVER_COOKIE_SECRET=substitua_por_um_segredo_aleatorio_com_64_caracteres

# SMTP usado para recuperação de senha e resumos semanais autorizados.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_USE_SSL=false
EMAIL_FROM=FinScope <no-reply@finscope.local>
# Destino privado dos comentários enviados pela interface.
FEEDBACK_TO_EMAIL=seu-email-de-feedback@exemplo.com
